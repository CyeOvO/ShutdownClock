<Window x:Class="ShutdownClock.Views.FloatingClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShutdownClock 倒计时"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        MinWidth="180" MinHeight="90"
        Width="420" Height="190"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDragMove">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="10" Background="#E6101014" Padding="8"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题 + 操作按钮（鼠标移入才显示） -->
            <Grid x:Name="TopBar" Grid.Row="0" Margin="2,0,2,4">
                <TextBlock x:Name="TitleText" Foreground="#CCFFFFFF" FontSize="12"
                           VerticalAlignment="Center" Text="倒计时"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StyleButton" Style="{StaticResource IconButton}" Content="样式"
                            Click="OnCycleStyle" ToolTip="切换显示样式"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="置顶"
                            Margin="4,0,0,0" Click="OnToggleTopmost" ToolTip="切换窗口置顶"/>
                    <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Content="取消"
                            Margin="4,0,0,0" Click="OnCancel" ToolTip="取消本次定时任务"/>
                    <Button x:Name="MinButton" Style="{StaticResource IconButton}" Content="－"
                            Margin="4,0,0,0" Click="OnShrink" ToolTip="缩小成角落小窗"/>
                </StackPanel>
            </Grid>

            <!-- 中间：倒计时主体 -->
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                <Grid x:Name="ClockHost" Width="420" Height="120">
                    <!-- 翻页时钟 -->
                    <ContentControl x:Name="FlipHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 大字 -->
                    <TextBlock x:Name="BigDigits" Text="00:00:00"
                               FontFamily="Consolas, Segoe UI, Microsoft YaHei"
                               FontWeight="Bold" Foreground="White"
                               FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- 进度环 -->
                    <Grid x:Name="RingHost" Visibility="Collapsed">
                        <Canvas Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="130" Height="130"
                                     Stroke="#33FFFFFF" StrokeThickness="10"/>
                            <Path x:Name="RingArc" Stroke="#FF5AC8FA" StrokeThickness="10"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock x:Name="RingText" Text="00:00:00"
                                   FontFamily="Consolas, Segoe UI" FontWeight="Bold"
                                   Foreground="White" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 极简 -->
                    <TextBlock x:Name="MinimalText" Text="" Foreground="#FFB4B4C0"
                               FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Viewbox>

            <!-- 底部：状态 -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#99FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
