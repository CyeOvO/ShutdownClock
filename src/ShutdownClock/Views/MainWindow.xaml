<Window x:Class="ShutdownClock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShutdownClock · 定时关机 / 休眠"
        Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#FF2E7DF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A90FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF333338"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮：颜色由代码后置按主题注入 -->
        <Style TargetType="Button" x:Key="IconQuick">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="ActionRadio">
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 输入框：颜色由代码后置按主题注入 -->
        <Style TargetType="TextBox" x:Key="TimeBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 权限提示条：非管理员时显示 -->
        <Border x:Name="ElevateBar" Grid.Row="0" Background="#334A2A00" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="#66FFB74D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="#FFB25E00" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="当前不是管理员权限，关机 / 重启可能失败。请关闭后右键选择“以管理员身份运行”。"/>
                <Button Grid.Column="1" Content="尝试提权重启" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" Padding="12,6" FontSize="12" Click="OnElevate"/>
            </Grid>
        </Border>

        <!-- 标题 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock x:Name="AppTitle" Text="ShutdownClock" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="AppSubtitle" Text="定时关机 / 重启 / 休眠 / 睡眠"
                       FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 动作选择 -->
        <Border x:Name="ActionCard" Grid.Row="2" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="ActionLabel" Text="1. 选择要执行的动作" FontSize="12" Margin="0,0,0,10"/>
                <WrapPanel>
                    <RadioButton x:Name="RbShutdown" Style="{StaticResource ActionRadio}"
                                 Content="关机" IsChecked="True" GroupName="Action"/>
                    <RadioButton x:Name="RbRestart" Style="{StaticResource ActionRadio}"
                                 Content="重启" GroupName="Action"/>
                    <RadioButton x:Name="RbHibernate" Style="{StaticResource ActionRadio}"
                                 Content="休眠" GroupName="Action"/>
                    <RadioButton x:Name="RbSleep" Style="{StaticResource ActionRadio}"
                                 Content="睡眠" GroupName="Action"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 时间输入 -->
        <Border x:Name="TimeCard" Grid.Row="3" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TimeLabel" Text="2. 选择时间" FontSize="12" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TimeBox" Grid.Column="0" Style="{StaticResource TimeBox}"
                             KeyDown="OnTimeBoxKeyDown"
                             ToolTip="支持：2026-11-10 23:30 / 23:30 / +90 / +2h / +30s"/>
                    <Button Grid.Column="1" Content="设定" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="OnStartClick"/>
                </Grid>

                <TextBlock x:Name="FormatHint" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="写法：2026-11-10 23:30（完整）／23:30（今天，已过则顺延明天）／+90（90 分钟后）／+2h／+30s"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="QuickLabel" Text="快捷：" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="5 分钟" Style="{StaticResource IconQuick}" Click="OnQuick5"/>
                    <Button Content="15 分钟" Style="{StaticResource IconQuick}" Click="OnQuick15"/>
                    <Button Content="30 分钟" Style="{StaticResource IconQuick}" Click="OnQuick30"/>
                    <Button Content="1 小时" Style="{StaticResource IconQuick}" Click="OnQuick60"/>
                    <Button Content="2 小时" Style="{StaticResource IconQuick}" Click="OnQuick120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 显示样式 -->
        <Border x:Name="StyleCard" Grid.Row="4" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="StyleLabel" Text="3. 倒计时显示样式" FontSize="12" Margin="0,0,0,10"/>
                <ComboBox x:Name="StyleBox" SelectionChanged="OnStyleChanged" FontSize="14" Padding="8,6">
                    <ComboBoxItem Content="大字倒计时（单行 HH:MM:SS）" IsSelected="True"/>
                    <ComboBoxItem Content="进度环（环形进度 + 中心数字）"/>
                    <ComboBoxItem Content="极简一行（仅文字）"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 当前任务 / 日志 -->
        <Border x:Name="StateCard" Grid.Row="5" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock x:Name="StateLabel" Text="当前任务" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock x:Name="StateText" Text="尚未排定任务"
                           FontSize="13" TextWrapping="Wrap"/>
                <Button x:Name="CancelTaskButton" Content="取消当前任务" Style="{StaticResource PrimaryButton}"
                        Margin="0,12,0,0" HorizontalAlignment="Left"
                        Background="#FF8A3B3B" Visibility="Collapsed" Click="OnCancelTask"/>
            </StackPanel>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="HintText" VerticalAlignment="Center"
                       Margin="0,0,14,0" FontSize="12"/>
            <Button x:Name="AbortButton" Content="恢复已排定的系统关机" Style="{StaticResource PrimaryButton}"
                    Click="OnAbortSystem"/>
        </StackPanel>
    </Grid>
</Window>
