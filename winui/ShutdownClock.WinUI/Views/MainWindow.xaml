<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShutdownClock.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>

    <Grid x:Name="RootGrid">
        <!-- 背景层：Mica 材质的兜底底色 -->
        <Grid.Background>
            <SolidColorBrush x:Name="PageBackground" />
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
            <StackPanel MaxWidth="620" HorizontalAlignment="Stretch">

                <!-- 权限提示条 -->
                <InfoBar x:Name="ElevateBar"
                         Severity="Warning"
                         Title="不是管理员权限"
                         Message="关机 / 重启可能失败。请关闭后右键选择“以管理员身份运行”。"
                         IsOpen="False"
                         IsClosable="False"
                         Margin="0,0,0,14">
                    <InfoBar.ActionButton>
                        <Button Content="尝试提权重启" Click="OnElevate" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 标题 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock x:Name="AppTitle" Text="ShutdownClock"
                               FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppSubtitle" Text="定时关机 / 重启 / 休眠 / 睡眠"
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 1. 动作 -->
                <Border x:Name="ActionCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="1. 选择要执行的动作" Style="{StaticResource SectionLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton x:Name="RbShutdown" Content="关机" IsChecked="True" GroupName="Action" />
                            <RadioButton x:Name="RbRestart" Content="重启" GroupName="Action" />
                            <RadioButton x:Name="RbHibernate" Content="休眠" GroupName="Action" />
                            <RadioButton x:Name="RbSleep" Content="睡眠" GroupName="Action" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. 时间 -->
                <Border x:Name="TimeCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="2. 选择时间" Style="{StaticResource SectionLabelStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TimeBox" Grid.Column="0"
                                     FontFamily="Consolas" FontSize="16"
                                     KeyDown="OnTimeBoxKeyDown"
                                     PlaceholderText="2026-11-10 23:30 或 +90"
                                     ToolTipService.ToolTip="支持：2026-11-10 23:30 / 23:30 / +90 / +2h / +30s" />
                            <Button Grid.Column="1" Content="设定" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnStartClick" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"
                                   Text="写法：2026-11-10 23:30（完整）／23:30（今天，已过则顺延明天）／+90（90 分钟后）／+2h／+30s" />

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                            <TextBlock Text="快捷：" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="5 分钟" Click="OnQuick5" />
                            <Button Content="15 分钟" Click="OnQuick15" />
                            <Button Content="30 分钟" Click="OnQuick30" />
                            <Button Content="1 小时" Click="OnQuick60" />
                            <Button Content="2 小时" Click="OnQuick120" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. 样式 -->
                <Border x:Name="StyleCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="3. 倒计时显示样式" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox x:Name="StyleBox" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnStyleChanged">
                            <ComboBoxItem Content="大字倒计时（单行 HH:MM:SS）" IsSelected="True" />
                            <ComboBoxItem Content="进度环（环形进度 + 中心数字）" />
                            <ComboBoxItem Content="极简一行（仅文字）" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 当前任务 -->
                <Border x:Name="StateCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="当前任务" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="StateText" Text="尚未排定任务" FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="CancelTaskButton" Content="取消当前任务"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="OnCancelTask" />
                    </StackPanel>
                </Border>

                <!-- 底部 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Grid.Column="0" VerticalAlignment="Center"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Content="恢复已排定的系统关机" Click="OnAbortSystem" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
