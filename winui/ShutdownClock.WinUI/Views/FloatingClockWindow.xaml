<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShutdownClock.Views.FloatingClockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <!-- 圆角背景 -->
        <Border x:Name="RootBorder" CornerRadius="10" Padding="8"
                BorderThickness="1" Background="#E6101014" BorderBrush="#33FFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：标题 + 操作按钮（鼠标移入才显示） -->
                <Grid x:Name="TopBar" Grid.Row="0" Margin="2,0,2,4"
                      PointerEntered="OnBarEntered" PointerExited="OnBarExited">
                    <TextBlock x:Name="TitleText" Text="倒计时" FontSize="12"
                               VerticalAlignment="Center" Foreground="#CCFFFFFF" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button x:Name="StyleButton" Content="大字" FontSize="11" Padding="8,2"
                                Click="OnCycleStyle" ToolTipService.ToolTip="切换显示样式" />
                        <Button x:Name="PinButton" Content="置顶" FontSize="11" Padding="8,2"
                                Click="OnToggleTopmost" ToolTipService.ToolTip="切换窗口置顶" />
                        <Button x:Name="CancelButton" Content="取消" FontSize="11" Padding="8,2"
                                Click="OnCancel" ToolTipService.ToolTip="取消本次定时任务" />
                        <Button x:Name="MinButton" Content="－" FontSize="11" Padding="8,2"
                                Click="OnShrink" ToolTipService.ToolTip="缩小成角落小窗" />
                    </StackPanel>
                </Grid>

                <!-- 中间：倒计时主体。用 Viewbox 等比缩放适配窗口大小 -->
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                    <Grid Width="420" Height="120">

                        <!-- 大字 -->
                        <TextBlock x:Name="BigDigits" Text="00:00:00"
                                   FontFamily="Consolas" FontWeight="Bold"
                                   Foreground="White" FontSize="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- 进度环：正方形画布，环直径 = 边长 -->
                        <Viewbox x:Name="RingHost" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="150" Height="150">
                                <Ellipse x:Name="RingTrackCircle" Width="150" Height="150"
                                         Stroke="#33FFFFFF" StrokeThickness="10" />
                                <Path x:Name="RingArc" Stroke="#5AC8FA" StrokeThickness="10"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="RingText" Text="00:00:00"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           Foreground="White" FontSize="26"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>

                        <!-- 极简 -->
                        <TextBlock x:Name="MinimalText" Text="" Foreground="#B4B4C0"
                                   FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Viewbox>

                <!-- 底部状态 -->
                <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>